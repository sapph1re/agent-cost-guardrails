{
  "name": "agent-cost-guardrails",
  "version": "0.1.0",
  "description": "Budget limits and cost guardrails for AI agents. Prevents runaway API spend with hard budget enforcement, circuit breakers, and per-agent cost tracking.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "agents",
    "cost",
    "budget",
    "guardrails",
    "llm",
    "openai",
    "anthropic",
    "langchain",
    "langgraph",
    "token-limit",
    "circuit-breaker"
  ],
  "author": "sapph1re",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sapph1re/agent-cost-guardrails",
    "directory": "js"
  },
  "homepage": "https://github.com/sapph1re/agent-cost-guardrails",
  "bugs": {
    "url": "https://github.com/sapph1re/agent-cost-guardrails/issues"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
